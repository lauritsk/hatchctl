amends "package://github.com/jdx/hk/releases/download/v1.44.2/hk@1.44.2#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.44.2/hk@1.44.2#/Builtins.pkl"

local linters = new Mapping<String, Step> {
  ["byte-order-marker"] = Builtins.byte_order_marker
  ["check-added-large-files"] = Builtins.check_added_large_files
  ["check-case-conflict"] = Builtins.check_case_conflict
  ["check-executables-have-shebangs"] = Builtins.check_executables_have_shebangs
  ["check-merge-conflict"] = Builtins.check_merge_conflict
  ["check-symlinks"] = Builtins.check_symlinks
  ["fix-smart-quotes"] = Builtins.fix_smart_quotes
  ["mixed-line-ending"] = Builtins.mixed_line_ending
  ["end-of-file-fixer"] = Builtins.newlines
  ["trailing-whitespace"] = Builtins.trailing_whitespace
  ["mise"] = Builtins.mise
  ["actionlint"] = Builtins.actionlint
  ["zizmor"] = Builtins.zizmor
  ["pkl"] = Builtins.pkl
  ["pkl-format"] = Builtins.pkl_format
  ["jq"] = Builtins.jq
  ["shellcheck"] = Builtins.shellcheck
  ["shfmt"] = Builtins.shfmt
  ["tombi"] = Builtins.tombi
  ["tombi-format"] = Builtins.tombi_format
  ["yamllint"] = (Builtins.yamllint) {
    exclude = List(".github/**")
  }
  ["yamlfmt"] = (Builtins.yamlfmt) {
    exclude = List(".github/**")
  }
  ["goreleaser"] = new Step {
    glob = ".goreleaser.yaml"
    check = "goreleaser check"
  }
  ["gomod-tidy"] = Builtins.gomod_tidy
  ["go-fumpt"] = Builtins.go_fumpt
  ["go-vet"] = Builtins.go_vet
  ["betterleaks"] = Builtins.betterleaks
  ["harper"] = (Builtins.harper) {
    glob = List("README.md", "AGENTS.md", "CONTRIBUTING.md", "SECURITY.md")
  }
  ["trivy-fs"] = new Step {
    glob = "**/*"
    check =
      "trivy fs --scanners vuln,misconfig,secret --severity HIGH,CRITICAL --ignore-unfixed --skip-dirs internal/devcontainer/testdata --exit-code 1 ."
  }
  ["lychee"] = (Builtins.lychee) {
    exclude = List("internal/**", "mise.lock")
  }
}

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = linters
  }
  ["fix"] {
    fix = true
    steps = linters
  }
  ["check"] {
    steps = linters
  }
  ["commit-msg"] {
    steps {
      ["cocogitto-commit-msg"] = Builtins.cocogitto_commit_msg
    }
  }
}
